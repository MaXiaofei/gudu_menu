{
  "$schema": "咕嘟小食单 · design tokens (extracted from prototypes 2026-07-28)",
  "$description": "Machine-readable canonical tokens. Source: .superpowers/brainstorm/44829-1783002708 (13 screens) + 41263-1782996859 (5 screens). Maps to docs/design/design-themes.html.",

  "color": {
    "theme": {
      "cream": {
        "$description": "主题 A · 奶油轻食 · 焦糖橙 + 奶油 · 温暖轻盈",
        "primary":      "#E89150",
        "primaryDeep":  "#D17A3C",
        "primarySoft":  "#F6D9BE",
        "secondary":    "#FBF0DD",
        "accent":       "#B8762E",
        "bg":           "#FDFAF4",
        "card":         "#FFFFFF",
        "border":       "#F0E6D6",
        "title":        "#4A382A",
        "body":         "#6E5C49",
        "caption":      "#9C8C7A",
        "highlight":    "#FFF7EC",
        "shadowRgb":    "169,101,30"
      },
      "matcha": {
        "$description": "主题 B · 抹茶禅意 · 草木绿 + 米白 · 安静克制",
        "primary":      "#7A9A5B",
        "primaryDeep":  "#648449",
        "primarySoft":  "#D8E2C8",
        "secondary":    "#E8E4D5",
        "accent":       "#6B8A4D",
        "bg":           "#F7F5EE",
        "card":         "#FFFFFF",
        "border":       "#E5E2D5",
        "title":        "#2E3520",
        "body":         "#6B7660",
        "caption":      "#9CA58F",
        "highlight":    "#FBF9EC",
        "shadowRgb":    "122,154,91"
      }
    },
    "semantic": {
      "$description": "两套主题共享的功能色 + 新增 soft/deep 变体（原型实际使用）",
      "success":      "#4FAE6E",
      "successSoft":  "#F0F8EE",
      "successDeep":  "#3E8C58",
      "warning":      "#E5A938",
      "warningSoft":  "#FFF7EC",
      "warningDeep":  "#B8762E",
      "error":        "#DB5A4E",
      "errorSoft":    "#FBD9D5",
      "errorDeep":    "#B8382B",
      "info":         "#4FA0D0",
      "infoSoft":     "#E8F3FA",
      "infoDeep":     "#3E7FA6"
    },
    "primitive": {
      "$description": "原始色板，仅供语义 token 参考，业务代码不应直接使用",
      "cream": {
        "orange": { "50": "#FFF7EC", "100": "#FBF0DD", "200": "#F6D9BE", "400": "#E89150", "600": "#D17A3C", "800": "#B8762E" },
        "neutral": { "0": "#FFFFFF", "50": "#FDFAF4", "100": "#F0E6D6", "400": "#9C8C7A", "600": "#6E5C49", "800": "#4A382A" },
        "red":     { "50": "#FBD9D5", "400": "#DB5A4E", "700": "#B8382B" },
        "green":   { "50": "#F0F8EE", "400": "#4FAE6E", "700": "#3E8C58" },
        "yellow":  { "400": "#E5A938" },
        "blue":    { "50": "#E8F3FA", "400": "#4FA0D0", "700": "#3E7FA6" }
      }
    }
  },

  "gradient": {
    "$description": "原型中实际出现的渐变",
    "heroPrimary":  "linear-gradient(135deg, var(--primary), var(--primary-deep))",
    "heroPrimaryRaw": "linear-gradient(135deg,#E89150,#D17A3C)"
  },

  "typography": {
    "$description": "字号阶梯 · 原型实际使用的 13 档；font-family 统一走 body",
    "fontFamily": {
      "sans": "-apple-system, 'PingFang SC', 'Segoe UI', Roboto, sans-serif"
    },
    "scale": {
      "display":  { "size": 40, "weight": 800, "lineHeight": 1.2 },
      "h1":       { "size": 32, "weight": 800, "lineHeight": 1.25 },
      "h2":       { "size": 24, "weight": 700, "lineHeight": 1.3 },
      "h3":       { "size": 20, "weight": 700, "lineHeight": 1.3 },
      "subtitle": { "size": 18, "weight": 700, "lineHeight": 1.35 },
      "lg":       { "size": 16, "weight": 600, "lineHeight": 1.4 },
      "md":       { "size": 14, "weight": 400, "lineHeight": 1.5 },
      "sm":       { "size": 12, "weight": 400, "lineHeight": 1.5 },
      "xs":       { "size": 11, "weight": 700, "lineHeight": 1.4, "note": "section label / chip text" },
      "tiny":     { "size": 10, "weight": 800, "lineHeight": 1.4, "note": "micro label, badge, callout" },
      "micro":    { "size":  9, "weight": 800, "lineHeight": 1.4, "note": "tab bar label, meta text" }
    },
    "weight": {
      "regular": 400,
      "medium":  500,
      "semi":    600,
      "bold":    700,
      "heavy":   800
    }
  },

  "radius": {
    "$description": "圆角阶梯 · 原型实测：2/4/5/6/7/8/9/10/11/12/14/16/22/99",
    "none": 0,
    "xs":   4,
    "sm":   8,
    "md":   12,
    "lg":   16,
    "xl":   22,
    "pill": 999,
    "circle": "50%",
    "legacy": {
      "$description": "design-themes.html 中定义但原型中较少出现的档",
      "rs": 8,
      "rmd": 14,
      "rlg": 22
    }
  },

  "shadow": {
    "$description": "阴影阶梯 · 色调跟随主题（通过 --sh rgb 变量）",
    "sm":  "0 1px 3px rgba(var(--sh), .08)",
    "md":  "0 6px 18px rgba(var(--sh), .10)",
    "lg":  "0 14px 36px rgba(var(--sh), .14)",
    "fab": "0 4px 12px rgba(var(--primary-rgb), .40)",
    "inner": "inset 0 0 0 1px rgba(var(--sh), .06)"
  },

  "spacing": {
    "$description": "间距阶梯 · 4px 基数；原型额外使用的 2/5/6/7/9/10 也补齐",
    "xxs":  2,
    "xs":   4,
    "sm":   8,
    "md":   12,
    "lg":   16,
    "xl":   24,
    "xxl":  32,
    "xxxl": 48
  },

  "border": {
    "hairline": "1px",
    "default":  "1.5px",
    "strong":   "2px"
  },

  "motion": {
    "duration": {
      "fast":   "150ms",
      "normal": "250ms",
      "slow":   "400ms"
    },
    "easing": {
      "default":   "cubic-bezier(.4,0,.2,1)",
      "decelerate": "cubic-bezier(0,0,.2,1)",
      "accelerate": "cubic-bezier(.4,0,1,1)"
    }
  },

  "layout": {
    "$description": "全局布局尺寸（来自 home-aisho / app-shell）",
    "pageMaxWidth":      "340px (mobile prototype viewport)",
    "appShellMaxWidth":  "1000px (docs/design preview wrap)",
    "tabBar": {
      "height":          "56px",
      "iconSize":        "20px",
      "labelSize":       "9px",
      "fabSize":         "40px",
      "fabOverflow":     "-16px"
    },
    "section": {
      "padding":         "22px 24px",
      "gap":             "18px"
    },
    "card": {
      "padding":         "13px 15px 17px"
    }
  },

  "zIndex": {
    "base":    0,
    "dropdown": 100,
    "sticky":  200,
    "fab":     300,
    "modal":   1000,
    "toast":   1100
  }
}
